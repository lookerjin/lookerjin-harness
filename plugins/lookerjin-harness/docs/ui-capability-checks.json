  "fixture_after_html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Account email</title>\n<style>body{font:18px Georgia,serif;background:#f6f7f8;color:#172632;margin:0}main{max-width:600px;padding:24px;margin:auto}h1{font-size:32px}label{display:block;margin-top:24px}input{box-sizing:border-box;width:100%;padding:12px;font:inherit}button{font:inherit;padding:12px 24px;margin-top:16px;background:#146454;color:white;border:0;border-radius:6px}a{color:#164f8c}:focus-visible{outline:3px solid #164f8c;outline-offset:3px}[hidden]{display:none}#errors{padding:16px;border:2px solid #9c2539;margin:16px 0}</style></head>\n<body><main><h1>Account email</h1><p>Choose where to receive account notifications.</p>\n<form novalidate><div id=\"errors\" role=\"alert\" tabindex=\"-1\" hidden><h2>Check your email address</h2><a href=\"#email\">Enter a valid email address</a></div>\n<label for=\"email\">Email address</label><input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"email\" aria-describedby=\"hint field-error\"><p id=\"hint\">For example, you@example.com</p><p id=\"field-error\" hidden>Enter a valid email address.</p><button type=\"submit\">Save email</button><p id=\"success\" role=\"status\"></p></form></main>\n<script>const form=document.querySelector('form');const email=document.querySelector('#email');const errors=document.querySelector('#errors');form.addEventListener('submit',event=>{event.preventDefault();const invalid=!email.value||!email.validity.valid;errors.hidden=!invalid;document.querySelector('#field-error').hidden=!invalid;email.setAttribute('aria-invalid',String(invalid));document.querySelector('#success').textContent=invalid?'':'Email saved';if(invalid) errors.focus();});</script>\n</body></html>\n",
